BACKEND_URL=https://medusa-api.avtechno.org
FRONTEND_URL=https://medusa.avtechno.org

# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key by reading DEPLOYMENT_GUIDE.md in the repo
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=${BACKEND_URL}

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=ph

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=${FRONTEND_URL}

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=production

MEDUSA_BACKEND_URL=${BACKEND_URL}
STORE_CORS=${FRONTEND_URL},https://docs.medusajs.com
ADMIN_CORS=http://medusa:5173,${BACKEND_URL},https://docs.medusajs.com
AUTH_CORS=http://medusa:5173,${BACKEND_URL},https://docs.medusajs.com
REDIS_URL=redis://redis:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store
DB_NAME=medusa-store
ADMIN_USER=mannyless37@gmail.com
ADMIN_PASSWORD=sample@123